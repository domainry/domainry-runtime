      "type": "table"
    }
  ],
  "workflows": [
    {
      "action": {
        "type": "workflow_graph"
      },
      "condition": {
        "equals": "low_stock",
        "field": "status"
      },
      "condition_contract": {
        "field": "status",
        "type": "field_equals",
        "value": "low_stock"
      },
      "enabled": true,
      "graph": {
        "edges": [
          {
            "id": "trigger-execute",
            "source": "trigger",
            "target": "execute"
          }
        ],
        "nodes": [
          {
            "id": "trigger",
            "name": "Trigger Low Stock Watch",
            "type": "trigger"
          },
          {
            "contract": {
              "action": {
                "action_key": "stock_item.low_stock_watch.execute",
                "object_key": "stock_item",
                "on_error": "fail"
              }
            },
            "id": "execute",
            "name": "Execute Low Stock Watch",
            "type": "action"
          }
        ],
        "version": 2
      },
      "key": "stock_item.low_stock_watch",
      "name": "Low Stock Watch",
      "run_as": "inventory_manager",
      "trigger": {
        "object_key": "stock_item",
        "type": "scheduled:daily"
      },
      "trigger_contract": {
        "event": "daily",
        "object_key": "stock_item",
        "type": "scheduled"
      }
    }
  ]
