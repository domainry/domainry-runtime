  "name": "Runtime ERP Inventory",
  "objects": [
    {
      "description": "Inventory item with reorder signal.",
      "fields": [
        {
          "key": "sku",
          "name": "SKU",
          "required": true,
          "type": "text",
          "unique": true
        },
        {
          "key": "name",
          "name": "Name",
          "required": true,
          "type": "text"
        },
        {
          "config": {
            "dictionary_key": "stock_item_status"
          },
          "key": "status",
          "name": "Status",
          "required": true,
          "type": "select",
          "validation": {
            "options": [
              "normal",
              "low_stock",
              "blocked"
            ]
          }
        },
        {
          "key": "on_hand",
          "name": "On Hand",
          "required": true,
          "type": "number"
        },
        {
          "key": "reorder_point",
          "name": "Reorder Point",
          "required": true,
          "type": "number"
        }
      ],
      "key": "stock_item",
      "name": "Stock Item"
    },
    {
      "description": "Replenishment request for low-stock items.",
      "fields": [
        {
          "key": "stock_item",
          "name": "Stock Item",
          "required": true,
          "type": "relation",
          "validation": {
            "target": "stock_item"
          }
        },
        {
          "config": {
            "dictionary_key": "purchase_request_status"
          },
          "key": "status",
          "name": "Status",
          "required": true,
          "type": "select",
          "validation": {
            "options": [
              "draft",
              "submitted",
              "approved"
            ]
          }
        },
        {
          "key": "quantity",
          "name": "Quantity",
          "required": true,
          "type": "number"
        }
      ],
      "key": "purchase_request",
      "name": "Purchase Request"
    }
  ],
  "reports": [
    {
      "key": "inventory_reorder_exposure",
      "name": "Inventory Reorder Exposure",
      "required_permissions": [
        "stock_item.read"
      ],
      "dataset": {
        "source": {"object_key": "stock_item", "alias": "stock_item"},
        "joins": [{"alias": "purchase_request", "object_key": "purchase_request", "type": "left", "left_alias": "stock_item", "left_field": "id", "right_field": "stock_item", "cardinality": "one_to_many"}]
      }
    }
  ],
  "roles": [
