      "object_key": "payment",
      "label": "Reconcile Timeout",
      "kind": "record_operation",
      "audit_event": "payment_timeout_reconciled"
    },
    {
      "key": "return_request.approve",
      "object_key": "return_request",
      "label": "Approve Return",
      "kind": "record_operation",
      "audit_event": "return_approved_inventory_restored"
    },
    {
      "key": "return_request.retry_refund",
      "object_key": "return_request",
      "label": "Retry Refund",
      "kind": "record_operation",
      "audit_event": "return_refund_compensated"
    }
  ],
  "automation_rules": [
    {
      "key": "sales_order.initialize_risk",
      "name": "Initialize Sales Order Risk",
      "object_key": "sales_order",
      "enabled": true,
      "trigger": {
        "phase": "after",
        "operation": "create"
      },
      "execution": {
        "mode": "async",
        "max_depth": 3
      },
      "instructions": [
        {
          "key": "initialize",
          "type": "invoke_business_action",
          "config": {
            "action_key": "sales_order.initialize_risk",
            "object_key": "sales_order"
          }
        }
      ]
    }
  ],
  "workflows": [
    {
      "key": "sales_order.credit_discount_approval",
      "name": "Sales Order Credit and Discount Approval",
      "trigger": {
        "type": "field_changed",
        "object_key": "sales_order",
        "field": "status"
      },
      "condition": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "trigger_contract": {
        "type": "field_changed",
        "object_key": "sales_order",
        "field_key": "status"
      },
      "condition_contract": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "action": {
        "type": "workflow_graph"
      },
      "enabled": true,
      "graph": {
        "version": 2,
        "nodes": [
          {
            "id": "submitted",
            "type": "trigger",
            "name": "Order Submitted"
          },
          {
            "id": "credit_review",
            "type": "approval",
            "name": "Credit Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "credit_manager"
                  }
                ]
              }
            }
          },
          {
            "id": "finance_review",
            "type": "approval",
            "name": "Independent Finance Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "finance"
                  }
                ]
              }
            }
          },
          {
            "id": "approve",
            "type": "action",
            "name": "Reserve Inventory",
            "contract": {
              "action": {
                "action_key": "sales_order.approve_and_reserve",
                "on_error": "fail"
              }
            }
          },
          {
            "id": "reject",
            "type": "action",
            "name": "Reject Order",
            "contract": {
              "action": {
                "action_key": "sales_order.reject",
                "on_error": "fail"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "submit-credit",
            "source": "submitted",
            "target": "credit_review"
          },
          {
            "id": "credit-approved",
            "source": "credit_review",
            "target": "finance_review",
            "branch": "approved"
          },
          {
            "id": "credit-rejected",
            "source": "credit_review",
            "target": "reject",
            "branch": "rejected"
          },
          {
            "id": "finance-approved",
            "source": "finance_review",
            "target": "approve",
            "branch": "approved"
          },
          {
            "id": "finance-rejected",
            "source": "finance_review",
            "target": "reject",
            "branch": "rejected"
          }
        ]
      }
    }
  ],
  "reports": [
    {
      "key": "order_to_cash_consistency",
      "name": "Order to Cash Consistency",
      "materialization": {
        "maximum_lag_seconds": 86400,
        "consistency_retries": 3
      },
      "object_sql_v1": {
        "sql": "SELECT sales_order.id AS id FROM sales_order sales_order ORDER BY sales_order.id LIMIT 100",
        "source_objects": ["sales_order"],
        "result_schema": [
          {"key": "id", "type": "text", "kind": "dimension"}
        ]
      },
      "required_permissions": [
        "sales_order.read"
      ]
    },
    {
      "key": "order_cash_reconciliation",
      "name": "Order Cash Reconciliation",
      "object_sql_v1": {
        "sql": "SELECT ledger.event AS event, COUNT(ledger.id) AS entries, SUM(ledger.amount) AS ledger_amount FROM order_cash_ledger ledger GROUP BY ledger.event ORDER BY ledger.event LIMIT 100",
        "source_objects": ["order_cash_ledger"],
        "result_schema": [
          {"key": "event", "type": "text", "kind": "dimension"},
          {"key": "entries", "type": "integer", "kind": "measure"},
          {"key": "ledger_amount", "type": "number", "kind": "measure"}
        ]
      },
      "required_permissions": [
        "order_cash_ledger.read"
      ]
    }
  ],
