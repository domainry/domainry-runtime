          "i18n": {
            "zh-CN": {
              "name": "年度"
            },
            "en": {
              "name": "Year"
            }
          }
        },
        {
          "key": "granted_days",
          "name": "Granted Days",
          "type": "number",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "授予天数"
            },
            "en": {
              "name": "Granted Days"
            }
          }
        },
        {
          "key": "remaining_days",
          "name": "Remaining Days",
          "type": "number",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "剩余天数"
