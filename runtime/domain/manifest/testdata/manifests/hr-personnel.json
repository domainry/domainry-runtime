{
  "template_id": "hr-personnel",
  "version": "1.0.0",
  "default_locale": "zh-CN",
  "name": "Personnel Leave Management",
  "i18n": {
    "zh-CN": {
      "name": "人事请假管理",
      "description": "人员汇报线、请假审批与余额台账"
    },
    "en": {
      "name": "Personnel Leave Management",
      "description": "Reporting lines, leave approvals, and balance ledger"
    }
  },
  "objects": [
    {
      "key": "leave_request",
      "name": "Leave Request",
      "i18n": {
        "zh-CN": {
          "name": "请假申请"
        },
        "en": {
          "name": "Leave Request"
        }
      },
      "fields": [
        {
          "key": "employee_user",
          "name": "Employee",
          "type": "user",
          "required": true,
          "config": {
            "indexed": true
          },
          "i18n": {
            "zh-CN": {
              "name": "员工"
            },
            "en": {
              "name": "Employee"
            }
          }
        },
        {
          "key": "leave_type",
          "name": "Leave Type",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "annual",
              "sick",
              "personal"
            ]
          },
          "i18n": {
            "zh-CN": {
              "name": "假期类型"
            },
            "en": {
              "name": "Leave Type"
            }
          }
        },
        {
          "key": "start_date",
          "name": "Start Date",
          "type": "date",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "开始日期"
            },
            "en": {
              "name": "Start Date"
            }
          }
        },
        {
          "key": "end_date",
          "name": "End Date",
          "type": "date",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "结束日期"
            },
            "en": {
              "name": "End Date"
            }
          }
        },
        {
          "key": "days",
          "name": "Days",
          "type": "number",
          "required": true,
          "validation": {
            "min": 0.5,
            "max": 30
          },
          "i18n": {
            "zh-CN": {
              "name": "天数"
            },
            "en": {
              "name": "Days"
            }
          }
        },
        {
          "key": "reason",
          "name": "Reason",
          "type": "long_text",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "请假原因"
            },
            "en": {
              "name": "Reason"
            }
          }
        },
        {
          "key": "status",
          "name": "Status",
          "type": "select",
          "required": true,
          "default_value": "draft",
          "validation": {
            "options": [
              "draft",
              "submitted",
              "returned",
              "approved",
              "rejected",
              "withdrawn",
              "cancelled"
            ]
          },
          "i18n": {
            "zh-CN": {
              "name": "状态"
            },
            "en": {
              "name": "Status"
            }
          }
        },
        {
          "key": "owner",
          "name": "Owner",
          "type": "user",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "数据负责人"
            },
            "en": {
              "name": "Owner"
            }
          }
        }
      ],
      "validations": [
        {
          "key": "leave_request_days_positive",
          "object_key": "leave_request",
          "type": "field",
          "field_key": "days",
          "severity": "error",
          "message": "hr.leave.days_invalid",
          "config": {
            "operator": "gt",
            "value": 0
          }
        },
        {
          "key": "leave_request_no_overlap",
          "object_key": "leave_request",
          "type": "temporal_exclusion",
          "severity": "error",
          "message": "hr.leave.period_overlap",
          "config": {
            "start_field": "start_date",
            "end_field": "end_date",
            "scope_fields": [
              "employee_user"
            ],
            "status_field": "status",
            "excluded_statuses": [
              "draft",
              "returned",
              "rejected",
              "withdrawn",
              "cancelled"
            ],
            "operations": [
              "action",
              "update",
              "create"
            ]
          }
        }
      ]
    },
    {
      "key": "leave_balance",
      "name": "Leave Balance",
      "i18n": {
        "zh-CN": {
          "name": "假期余额"
        },
        "en": {
          "name": "Leave Balance"
        }
      },
      "fields": [
        {
          "key": "employee_user",
