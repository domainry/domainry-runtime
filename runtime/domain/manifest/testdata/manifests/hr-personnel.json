          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "已用天数"
            },
            "en": {
              "name": "Used Days"
            }
          }
        },
        {
          "key": "owner",
          "name": "Owner",
          "type": "user",
          "required": true,
          "i18n": {
            "zh-CN": {
              "name": "数据负责人"
            },
            "en": {
              "name": "Owner"
            }
          }
        }
      ],
      "validations": [
        {
          "key": "leave_balance_unique",
          "object_key": "leave_balance",
          "type": "unique_together",
          "fields": [
            "employee_user",
            "leave_type",
            "year"
          ],
          "severity": "error",
          "message": "hr.leave.balance_unique"
