  "notification_templates": [
    {
      "key": "hr.leave.approval_reminder",
      "name": "Leave approval reminder",
      "channel": "email",
      "status": "published",
      "version": 1,
      "default_locale": "zh-CN",
      "variables": [
        {
          "key": "leave_request_id",
          "type": "text",
          "required": true
        },
        {
          "key": "workflow_task_id",
          "type": "text",
          "required": true
        }
      ],
      "locales": {
        "zh-CN": {
          "subject": "请假审批提醒：{{leave_request_id}}",
          "text": "请处理请假申请 {{leave_request_id}}，审批任务：{{workflow_task_id}}。",
          "html": "<p>请处理请假申请 <strong>{{leave_request_id}}</strong>。</p><p>审批任务：{{workflow_task_id}}</p>"
        },
        "en": {
          "subject": "Leave approval reminder: {{leave_request_id}}",
          "text": "Please review leave request {{leave_request_id}}. Approval task: {{workflow_task_id}}.",
          "html": "<p>Please review leave request <strong>{{leave_request_id}}</strong>.</p><p>Approval task: {{workflow_task_id}}</p>"
        }
      }
    },
    {
      "key": "hr.leave.result",
      "name": "Leave request result",
      "channel": "email",
      "status": "published",
      "version": 1,
      "default_locale": "zh-CN",
      "variables": [
        {
          "key": "leave_request_id",
          "type": "text",
          "required": true
        },
        {
          "key": "decision",
          "type": "text",
          "required": true
        }
      ],
      "locales": {
        "zh-CN": {
          "subject": "请假申请处理结果：{{leave_request_id}}",
          "text": "您的请假申请 {{leave_request_id}} 的处理结果为：{{decision}}。",
          "html": "<p>您的请假申请 <strong>{{leave_request_id}}</strong> 的处理结果为：<strong>{{decision}}</strong>。</p>"
        },
        "en": {
          "subject": "Leave request result: {{leave_request_id}}",
          "text": "The result for leave request {{leave_request_id}} is {{decision}}.",
          "html": "<p>The result for leave request <strong>{{leave_request_id}}</strong> is <strong>{{decision}}</strong>.</p>"
        }
      }
    }
  ],
  "workflows": [
    {
      "key": "leave_request_approval",
      "name": "Leave Request Approval",
      "i18n": {
        "zh-CN": {
          "name": "请假审批"
        },
        "en": {
          "name": "Leave Request Approval"
        }
      },
      "trigger": {
        "type": "field_changed",
        "object_key": "leave_request",
        "field": "status"
      },
      "condition": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "trigger_contract": {
        "type": "field_changed",
        "object_key": "leave_request",
        "field_key": "status"
      },
      "condition_contract": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "action": {
        "type": "workflow_graph"
      },
      "enabled": true,
      "idempotency_keys": [
        "request_id"
      ],
      "graph": {
        "version": 2,
        "nodes": [
          {
            "id": "submitted",
            "type": "trigger",
            "name": "Leave Submitted"
          },
          {
            "id": "manager",
            "type": "approval",
            "name": "Manager Approval",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "reminder_action_key": "leave_request.notify_approval_reminder",
                "reminder_input": {
                  "template_key": "hr.leave.approval_reminder"
                },
                "escalation_seconds": 3600,
                "escalation_resolvers": [
                  {
                    "type": "role",
                    "role_key": "hr_admin"
                  }
                ],
                "resolvers": [
                  {
                    "type": "manager_of",
                    "user_field": "employee_user"
                  }
                ]
              }
            }
          },
          {
            "id": "extended_leave",
            "type": "condition",
            "name": "Extended Leave Review Required",
            "contract": {
              "condition": {
                "type": "expression",
                "expression": "days >= 3"
              }
            }
          },
          {
            "id": "hr_review",
            "type": "approval",
            "name": "HR Extended Leave Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "reminder_action_key": "leave_request.notify_approval_reminder",
                "escalation_seconds": 3600,
                "escalation_resolvers": [
                  {
                    "type": "role",
                    "role_key": "admin"
                  }
                ],
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "hr_admin"
                  }
                ]
              }
            }
          },
          {
            "id": "approve",
            "type": "action",
            "name": "Approve and Debit Balance",
            "contract": {
              "action": {
                "action_key": "leave_request.approve",
                "on_error": "fail",
                "output_variable": "approval_action"
              }
            }
          },
          {
            "id": "reject",
            "type": "action",
            "name": "Reject Leave",
            "contract": {
              "action": {
                "action_key": "leave_request.reject",
                "input": {
                  "reason": "$workflow.approval_comment"
                },
                "on_error": "fail",
                "output_variable": "rejection_action"
              }
            }
          },
          {
            "id": "return",
            "type": "action",
            "name": "Return for Revision",
            "contract": {
              "action": {
                "action_key": "leave_request.return_for_revision",
                "on_error": "fail",
                "output_variable": "return_action"
              }
            }
          },
          {
            "id": "approved_notice",
            "type": "cc",
            "name": "Notify Approval Result",
            "contract": {
              "cc": {
                "notification_action_key": "leave_request.notify_result",
                "resolvers": [
                  {
                    "type": "record_field",
                    "field": "employee_user"
                  }
                ],
                "input": {
                  "decision": "approved"
                }
              }
            }
          },
          {
            "id": "rejected_notice",
            "type": "cc",
            "name": "Notify Rejection Result",
            "contract": {
              "cc": {
                "notification_action_key": "leave_request.notify_result",
                "resolvers": [
                  {
                    "type": "record_field",
                    "field": "employee_user"
                  }
                ],
                "input": {
                  "decision": "rejected"
                }
              }
            }
          }
        ],
        "edges": [
          {
            "id": "submit-manager",
            "source": "submitted",
            "target": "manager"
          },
          {
            "id": "manager-approved",
            "source": "manager",
            "target": "extended_leave",
            "branch": "approved"
          },
          {
            "id": "manager-rejected",
            "source": "manager",
            "target": "reject",
            "branch": "rejected"
          },
          {
            "id": "manager-returned",
            "source": "manager",
            "target": "return",
            "branch": "returned"
          },
          {
            "id": "extended-review-required",
            "source": "extended_leave",
            "target": "hr_review",
            "branch": "true"
          },
          {
            "id": "extended-review-not-required",
            "source": "extended_leave",
            "target": "approve",
            "branch": "false"
          },
          {
            "id": "hr-review-approved",
            "source": "hr_review",
            "target": "approve",
            "branch": "approved"
          },
          {
            "id": "hr-review-rejected",
            "source": "hr_review",
            "target": "reject",
            "branch": "rejected"
          },
          {
            "id": "hr-review-returned",
            "source": "hr_review",
            "target": "return",
            "branch": "returned"
          },
          {
            "id": "approve-notice",
            "source": "approve",
            "target": "approved_notice"
          },
          {
            "id": "reject-notice",
            "source": "reject",
            "target": "rejected_notice"
          }
        ]
      }
    }
  ],
