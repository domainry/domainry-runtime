  "identity_profile_extensions": [
    {
      "contract_version": "identity-profile-extension",
      "min_reader_version": "identity-profile-extension-reader",
      "object_key": "employee_profile",
      "identity_relation_field": "identity_user",
      "cardinality": "one_to_one",
      "business_identity": {
        "key": "employee",
        "claims": [
          {
            "claim_key": "profile_no",
            "field_key": "profile_no"
          },
          {
            "claim_key": "position_id",
            "field_key": "position"
          }
        ]
      },
      "summary_fields": [
        "profile_no",
        "legal_entity",
        "contract_status"
      ],
      "profile_tabs": [
        "employment",
        "contract"
      ],
      "profile_tab_labels": {
        "employment": "任职档案",
        "contract": "合同资料"
      },
      "profile_tab_fields": {
        "employment": [
          "profile_no",
          "legal_entity",
          "position"
        ],
        "contract": [
          "contract_type",
          "contract_status"
        ]
      },
      "default_visibility": "when_readable",
      "required_permissions": [
        "employee_profile.read"
      ],
      "standalone_workspace": false
    },
