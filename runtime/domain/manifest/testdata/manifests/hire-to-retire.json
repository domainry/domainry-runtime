  "notification_templates": [
    {
      "key": "htr.termination.completed",
      "name": "Termination completed",
      "channel": "email",
      "status": "published",
      "version": 1,
      "default_locale": "en",
      "variables": [
        {
          "key": "case_number",
          "type": "text",
          "required": true
        }
      ],
      "locales": {
        "en": {
          "subject": "Termination completed: {{case_number}}",
          "text": "Termination case {{case_number}} has completed.",
          "html": "<p>Termination case <strong>{{case_number}}</strong> has completed.</p>"
        }
      }
    }
  ],
  "workflows": [
    {
      "key": "candidate_offer.multilevel_approval",
      "name": "Candidate Offer Multilevel Approval",
      "trigger": {
        "type": "field_changed",
        "object_key": "candidate_offer",
        "field": "status"
      },
      "condition": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "trigger_contract": {
        "type": "field_changed",
        "object_key": "candidate_offer",
        "field_key": "status"
      },
      "condition_contract": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "action": {
        "type": "workflow_graph"
      },
      "enabled": true,
      "graph": {
        "version": 2,
        "nodes": [
          {
            "id": "submitted",
            "type": "trigger",
            "name": "Offer Submitted"
          },
          {
            "id": "manager_review",
            "type": "approval",
            "name": "Hiring Manager Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "hiring_manager"
                  }
                ]
              }
            }
          },
          {
            "id": "hr_review",
            "type": "approval",
            "name": "HR Budget Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "hr_admin"
                  }
                ]
              }
            }
          },
          {
            "id": "approve",
            "type": "action",
            "name": "Approve Offer",
            "contract": {
              "action": {
                "action_key": "candidate_offer.approve",
                "on_error": "fail"
              }
            }
          },
          {
            "id": "reject",
            "type": "action",
            "name": "Reject Offer",
            "contract": {
              "action": {
                "action_key": "candidate_offer.reject",
                "on_error": "fail"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "submitted-manager",
            "source": "submitted",
            "target": "manager_review"
          },
          {
            "id": "manager-approved",
            "source": "manager_review",
            "target": "hr_review",
            "branch": "approved"
          },
          {
            "id": "manager-rejected",
            "source": "manager_review",
            "target": "reject",
            "branch": "rejected"
          },
          {
            "id": "hr-approved",
            "source": "hr_review",
            "target": "approve",
            "branch": "approved"
          },
          {
            "id": "hr-rejected",
            "source": "hr_review",
            "target": "reject",
            "branch": "rejected"
          }
        ]
      }
    },
    {
      "key": "termination_case.approval",
      "name": "Termination Approval",
      "trigger": {
        "type": "field_changed",
        "object_key": "termination_case",
        "field": "status"
      },
      "condition": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "trigger_contract": {
        "type": "field_changed",
        "object_key": "termination_case",
        "field_key": "status"
      },
      "condition_contract": {
        "type": "field_equals",
        "field": "status",
        "value": "submitted"
      },
      "action": {
        "type": "workflow_graph"
      },
      "enabled": true,
      "graph": {
        "version": 2,
        "nodes": [
          {
            "id": "submitted",
            "type": "trigger",
            "name": "Termination Submitted"
          },
          {
            "id": "hr_review",
            "type": "approval",
            "name": "HR Termination Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "hr_admin"
                  }
                ]
              }
            }
          },
          {
            "id": "it_review",
            "type": "approval",
            "name": "IT Access Review",
            "contract": {
              "approval": {
                "mode": "any",
                "resolver_mode": "first_match",
                "empty_assignee_policy": "fail",
                "due_seconds": 86400,
                "resolvers": [
                  {
                    "type": "role",
                    "role_key": "it_admin"
                  }
                ]
              }
            }
          },
          {
            "id": "approve",
            "type": "action",
            "name": "Approve Due Termination",
            "contract": {
              "action": {
                "action_key": "termination_case.approve_due",
                "on_error": "fail"
              }
            }
          },
          {
            "id": "reject",
            "type": "action",
            "name": "Reject Termination",
            "contract": {
              "action": {
                "action_key": "termination_case.reject",
                "on_error": "fail"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "submitted-hr",
            "source": "submitted",
            "target": "hr_review"
          },
          {
            "id": "hr-approved",
            "source": "hr_review",
            "target": "it_review",
            "branch": "approved"
          },
          {
            "id": "hr-rejected",
            "source": "hr_review",
            "target": "reject",
            "branch": "rejected"
          },
          {
            "id": "it-approved",
            "source": "it_review",
            "target": "approve",
            "branch": "approved"
          },
          {
            "id": "it-rejected",
            "source": "it_review",
            "target": "reject",
            "branch": "rejected"
          }
        ]
      }
    },
    {
      "key": "termination_case.due_scheduler",
      "name": "Termination Date Scheduler",
      "run_as": "admin",
      "trigger": {
        "type": "scheduled:daily",
        "object_key": "termination_case"
      },
      "condition": {
        "type": "field_equals",
        "field": "status",
        "value": "approved_due"
      },
      "trigger_contract": {
        "type": "scheduled",
        "event": "daily",
        "object_key": "termination_case"
      },
      "condition_contract": {
        "type": "field_equals",
        "field": "status",
        "value": "approved_due"
      },
      "action": {
        "type": "workflow_graph"
      },
      "enabled": true,
      "graph": {
        "version": 2,
        "nodes": [
          {
            "id": "daily",
            "type": "trigger",
            "name": "Daily Termination Scan"
          },
          {
            "id": "execute",
            "type": "action",
            "name": "Execute Due Termination",
            "contract": {
              "action": {
                "action_key": "termination_case.execute_due",
                "on_error": "fail"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "daily-execute",
            "source": "daily",
            "target": "execute"
          }
        ]
      }
    }
  ],
  "integrations": {
    "connectors": [
      {
        "key": "benefit_webhook",
        "providers": [
