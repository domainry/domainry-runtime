        "interval_seconds": 3600,
        "timezone": "UTC",
        "target_type": "workflow",
        "target_key": "scheduled:*",
        "max_attempts": 3,
        "timeout_seconds": 300,
        "retry_backoff": "fixed",
        "retry_delay_seconds": 60,
        "retry_max_delay_seconds": 3600
      }
    },
    {
      "object_key": "job_run",
      "data": {
        "__seed_key": "scheduler_ops_failed_run",
        "scheduler_definition_key": "scheduler_ops_probe",
        "status": "failed",
