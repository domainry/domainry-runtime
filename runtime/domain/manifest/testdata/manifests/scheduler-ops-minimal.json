{
  "template_id": "scheduler_ops_minimal",
  "version": "0.2.0",
  "name": "Scheduler Operations Minimal",
  "objects": [
    {
      "key": "scheduler_probe",
      "name": "Scheduler Probe",
      "description": "Business record used by the Scheduler integration fixture; Scheduler lifecycle state remains owner-managed.",
      "fields": [
        {"key": "name", "name": "Name", "type": "text", "required": true},
        {"key": "owner", "name": "Owner", "type": "user", "required": true}
      ]
    }
  ],
  "roles": [
    {
      "key": "admin",
      "name": "Admin",
      "permissions": [
        "admin_console.access",
        "runtime.appschema.validate_application_definition",
        "scheduler.command",
        "scheduler.definition.read",
        "scheduler_probe.read"
      ],
      "record_scope": "all_records",
      "data_permissions": [
        {"object_key": "scheduler_probe", "scope": "all_records", "read": true, "write": true}
      ]
    }
  ],
  "scheduler_definitions": [
    {
      "key": "scheduler_ops_probe",
      "name": "Scheduler Operations Probe",
      "status": "disabled",
      "trigger_type": "scheduled",
      "schedule_type": "interval",
      "interval_seconds": 3600,
      "timezone": "UTC",
      "target_type": "workflow",
      "target_key": "scheduled:*",
      "missed_window_policy": "skip",
      "max_attempts": 3,
      "timeout_seconds": 300,
      "retry_backoff": "fixed",
      "retry_delay_seconds": 60,
      "retry_max_delay_seconds": 3600
    }
  ],
  "menus": [],
  "seed_records": [
    {
      "object_key": "scheduler_probe",
      "data": {
        "__seed_key": "scheduler_probe_record",
        "name": "Scheduler probe",
        "owner": "admin_user"
      }
    }
  ]
}
